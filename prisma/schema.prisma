generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
}

enum Currency {
  USD
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentProvider {
  STRIPE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(320)
  passwordHash String   @db.Text
  role         UserRole
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@index([role, active])
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(120)
  slug        String    @unique @db.VarChar(160)
  description String?   @db.Text
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  products    Product[]

  @@index([active, name])
}

model Product {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @db.VarChar(180)
  slug        String           @unique @db.VarChar(200)
  description String           @db.Text
  active      Boolean          @default(true)
  published   Boolean          @default(false)
  categoryId  String           @db.Uuid
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  category    Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants    ProductVariant[]
  images      ProductImage[]

  @@index([categoryId])
  @@index([published, active, createdAt])
}

model ProductVariant {
  id                  String      @id @default(uuid()) @db.Uuid
  productId           String      @db.Uuid
  sku                 String      @unique @db.VarChar(80)
  name                String      @db.VarChar(140)
  size                String?     @db.VarChar(40)
  color               String?     @db.VarChar(80)
  priceCents          Int
  compareAtPriceCents Int?
  stockQuantity       Int         @default(0)
  active              Boolean     @default(true)
  createdAt           DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @db.Timestamptz(3)
  product             Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems          OrderItem[]

  @@index([productId, active])
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  url       String   @db.Text
  altText   String   @db.VarChar(240)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sortOrder])
  @@index([productId])
}

model Order {
  id                 String             @id @default(uuid()) @db.Uuid
  orderNumber        String             @unique @db.VarChar(40)
  email              String             @db.VarChar(320)
  status             OrderStatus        @default(PENDING)
  currency           Currency           @default(USD)
  subtotalCents      Int
  shippingCents      Int
  taxCents           Int
  totalCents         Int
  shippingName       String             @db.VarChar(160)
  shippingLine1      String             @db.VarChar(200)
  shippingLine2      String?            @db.VarChar(200)
  shippingCity       String             @db.VarChar(120)
  shippingRegion     String?            @db.VarChar(120)
  shippingPostalCode String             @db.VarChar(32)
  shippingCountry    String             @db.Char(2)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)
  items              OrderItem[]
  payments           Payment[]
  statusEvents       OrderStatusEvent[]

  @@index([status, createdAt])
  @@index([email, createdAt])
}

model OrderItem {
  id               String          @id @default(uuid()) @db.Uuid
  orderId          String          @db.Uuid
  productVariantId String?         @db.Uuid
  productName      String          @db.VarChar(180)
  variantName      String          @db.VarChar(140)
  sku              String          @db.VarChar(80)
  unitPriceCents   Int
  quantity         Int
  lineTotalCents   Int
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productVariantId])
}

model Payment {
  id                String          @id @default(uuid()) @db.Uuid
  orderId           String          @db.Uuid
  provider          PaymentProvider
  providerPaymentId String?         @db.VarChar(255)
  status            PaymentStatus   @default(PENDING)
  amountCents       Int
  currency          Currency        @default(USD)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds           Refund[]

  @@unique([provider, providerPaymentId])
  @@index([orderId, createdAt])
  @@index([status, createdAt])
}

model Refund {
  id               String   @id @default(uuid()) @db.Uuid
  paymentId        String   @db.Uuid
  providerRefundId String?  @unique @db.VarChar(255)
  amountCents      Int
  reason           String?  @db.Text
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  payment          Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId, createdAt])
}

model OrderStatusEvent {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @db.Uuid
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?      @db.Text
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model StripeWebhookEvent {
  id            String    @id @default(uuid()) @db.Uuid
  stripeEventId String    @unique @db.VarChar(255)
  eventType     String    @db.VarChar(160)
  processedAt   DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  @@index([processedAt, createdAt])
}

model StoreSettings {
  id        String   @id @default(uuid()) @db.Uuid
  storeName String   @db.VarChar(160)
  currency  Currency @default(USD)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
